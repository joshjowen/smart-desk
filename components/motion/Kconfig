menu "Desk motion"

    config DESK_SIMULATOR
        bool "Simulated desk (opto outputs stay off)"
        default n
        help
            Motion drives a simulated desk instead of the opto outputs, for
            desk-free development. The outputs are still forced off at boot.

    config DESK_OPTO_ACTIVE_LOW
        bool "Opto inputs are active-low (sink mode)"
        default n
        help
            n: source mode, GPIO -> module IN (I1/I2), GPIO high = button pressed.
            y: sink mode, 5 V -> IN+, GPIO -> IN-, GPIO low = button pressed.

    config DESK_OPTO_UP_GPIO
        int "Opto UP GPIO"
        default 3

    config DESK_OPTO_DOWN_GPIO
        int "Opto DOWN GPIO"
        default 7

    config DESK_HANDSET_SENSE
        bool "Sense physical handset presses"
        default n
        help
            Reads the handset UP/DOWN lines (through a divider or opto) as inputs.
            A press during an automatic move stops it.

    config DESK_HANDSET_UP_GPIO
        int "Handset sense UP GPIO"
        depends on DESK_HANDSET_SENSE
        default 17

    config DESK_HANDSET_DOWN_GPIO
        int "Handset sense DOWN GPIO"
        depends on DESK_HANDSET_SENSE
        default -1
        help
            -1 = not connected.

    config DESK_HANDSET_ACTIVE_LOW
        bool "Handset sense inputs read low when pressed"
        depends on DESK_HANDSET_SENSE
        default y

    config DESK_SIM_SPEED_MM_S
        int "Simulated speed (mm/s)"
        depends on DESK_SIMULATOR
        default 25

    config DESK_SIM_MIN_MM
        int "Simulated lowest height (mm)"
        depends on DESK_SIMULATOR
        default 650

    config DESK_SIM_MAX_MM
        int "Simulated highest height (mm)"
        depends on DESK_SIMULATOR
        default 1150

    config DESK_SIM_START_MM
        int "Simulated height at boot (mm)"
        depends on DESK_SIMULATOR
        default 720

    config DESK_PRESET_SIT_MM
        int "Default Sit preset (mm)"
        default 720

    config DESK_PRESET_STAND_MM
        int "Default Stand preset (mm)"
        default 1100

    config DESK_SEEK_TOLERANCE_MM
        int "Seek tolerance (+/- mm)"
        default 8

    config DESK_MAX_MOVE_S_UNCAL
        int "Max single move time before calibration (s)"
        default 25

    config DESK_DUTY_WINDOW_S
        int "Duty-cycle rolling window (s)"
        range 120 3600
        default 1200

    config DESK_DUTY_MAX_ON_S
        int "Max motor-on time per window (s)"
        range 10 600
        default 120
        help
            Shorten (with the window) to test the cooldown path.

    config DESK_CAL_MOTOR_S
        int "Motor time the calibration routine needs (s)"
        range 30 115
        default 90
        help
            Calibration only starts with at least this much duty budget left.
            Worst case on a desk with ~31 s full travel is ~75 s.

    config DESK_DEBUG_COMMANDS
        bool "Debug console commands (fault/duty injection, crash)"
        default y

endmenu
